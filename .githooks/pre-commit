#!/usr/bin/env bash
# Before a commit leaves this laptop: no secret in what is being committed. `just check` and
# CI run gitleaks too, but on a public repo a secret found after the push is already out.
# Enabled by scripts/setup.sh (git config core.hooksPath .githooks).
set -euo pipefail

command -v gitleaks >/dev/null || {
    echo "pre-commit: gitleaks not found (~/.dotfiles/fedora/nix/home.nix) — commit refused" >&2
    exit 1
}
gitleaks git --staged --no-banner --redact --log-level warn || {
    echo "pre-commit: possible secret in the staged changes — commit refused (see above)" >&2
    exit 1
}
