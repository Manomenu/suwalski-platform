# Copy to secrets.auto.tfvars and fill in. That file is in .gitignore.
#
# You create the API token on Proxmox:
#
#   ssh pve 'pveum user token add root@pam terraform --privsep 0'
#
# It prints a value that is shown exactly once. Paste it here in full, together
# with the prefix — the UUID alone is not enough.
#
# --privsep 0 means "the token has the same permissions as the account". For root@pam that is
# full control over Proxmox. Eventually a separate account with a role limited to
# creating machines would be better — but first let it work.

proxmox_api_token = "root@pam!terraform=00000000-0000-0000-0000-000000000000"

# cat ~/.ssh/id_ed25519.pub
# A public key is not a secret, but it carries your email address in its comment —
# that is why we keep it here and not in a committed file.
ssh_public_keys = [
  "ssh-ed25519 AAAA... maniumek@fedora",
]
