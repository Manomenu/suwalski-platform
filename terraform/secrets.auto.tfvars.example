# Skopiuj do secrets.auto.tfvars i uzupełnij. Tamten plik jest w .gitignore.
#
# Token API tworzysz na Proxmoksie:
#
#   ssh pve 'pveum user token add root@pam terraform --privsep 0'
#
# Wypisze wartość, którą widać dokładnie raz. Wklej ją tutaj w całości, razem
# z przedrostkiem — sam UUID nie wystarczy.
#
# --privsep 0 znaczy „token ma te same uprawnienia co konto". Dla root@pam to pełna
# władza nad Proxmoksem. Docelowo lepiej mieć osobne konto z rolą ograniczoną do
# tworzenia maszyn — ale najpierw niech zadziała.

proxmox_api_token = "root@pam!terraform=00000000-0000-0000-0000-000000000000"

# cat ~/.ssh/id_ed25519.pub
# Klucz publiczny nie jest sekretem, ale niesie twój adres e-mail w komentarzu —
# dlatego trzymamy go tu, a nie w pliku commitowanym.
ssh_public_keys = [
  "ssh-ed25519 AAAA... maniumek@fedora",
]
