# Terraform state describes live infrastructure and contains values we do not want
# to publish. The provider lockfile is the opposite — it must be committed, because it is
# what guarantees everyone gets the same version.
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Variable values. Facts about the environment (proxmox.auto.tfvars) belong in the repo —
# they describe what runs where. Only secrets stay outside git.
secrets.auto.tfvars
.secrets.env
.secrets/
# Cloudflare Access groups: people's emails — private, and the repo is public.
terraform/edge/access/*.json
terraform.tfvars
*.tfvars.json

# Kubeconfig fetched from the cluster.
kubeconfig
*.kubeconfig
.suwgit.log
