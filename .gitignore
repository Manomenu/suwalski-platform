# Terraform state is encrypted (terraform/*/encryption.tf) and committed: the record of what
# Terraform built must survive this laptop. `just check` refuses a plain one. The automatic
# .backup copies stay out. The provider lockfile must be committed too — it is what
# guarantees everyone gets the same version.
**/.terraform/
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Variable values. Facts about the environment (proxmox.auto.tfvars) belong in the repo —
# they describe what runs where. Only secrets stay outside git.
secrets.auto.tfvars
.secrets.env
.secrets/
# Cloudflare Access groups: people's emails — private, and the repo is public.
terraform/edge/access/*.json
terraform.tfvars
*.tfvars.json

# Kubeconfig fetched from the cluster.
kubeconfig
*.kubeconfig
.suwgit.log
