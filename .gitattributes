# Line endings: LF in the repo and in every checkout, whatever the OS (matches .editorconfig).
* text=auto eol=lf

# Binary: never diffed as text, never normalised.
*.png binary
*.jpg binary
*.pdf binary

# The state is committed encrypted (terraform/*/encryption.tf): a text diff of ciphertext says
# nothing, so git shows it as changed without the noise. `tofu plan` is the readable diff.
terraform/*/terraform.tfstate -diff linguist-generated=true

# Generated by `tofu init`: collapsed in GitHub diffs, never edited by hand.
**/.terraform.lock.hcl linguist-generated=true
