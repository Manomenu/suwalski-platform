root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# The gate formats bash with `shfmt -i 4 -ci` — the editor indents the same.
[{*.sh,.githooks/*}]
indent_size = 4

[{justfile,*.just}]
indent_size = 4

# Two trailing spaces are a line break in Markdown.
[*.md]
trim_trailing_whitespace = false
